@{
    ViewData["Title"] = "Not Found";
}

<div class="access-denied-container">
    <div class="access-denied-card">
        <div class="access-denied-icon">🔎</div>
        <div class="access-denied-code">404</div>
        <h1 class="access-denied-title">We couldn't find that</h1>
        <p class="access-denied-message">The page or item doesn't exist, or you don't have access to it.</p>
        <div class="access-denied-actions">
            <a href="/" class="btn-tp-primary"><i class="bi bi-house-fill"></i> Go to Home</a>
            <a href="javascript:history.back()" class="btn-tp-secondary"><i class="bi bi-arrow-left"></i> Go Back</a>
        </div>
    </div>
</div>
