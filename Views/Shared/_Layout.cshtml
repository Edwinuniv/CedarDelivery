<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — CedarDelivery</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/cedardelivery.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <style>
        @@keyframes skeleton-shimmer {
            0% {
                background-position: -600px 0;
            }

            100% {
                background-position: 600px 0;
            }
        }

        .skeleton {
            background: linear-gradient(90deg, var(--surface-2) 25%, var(--border) 50%, var(--surface-2) 75%);
            background-size: 600px 100%;
            animation: skeleton-shimmer 1.4s infinite linear;
            border-radius: 6px;
        }

        .skeleton-text {
            height: 14px;
            margin-bottom: 8px;
        }

        .skeleton-title {
            height: 22px;
            margin-bottom: 10px;
            width: 60%;
        }

        .skeleton-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .skeleton-card {
            height: 80px;
            border-radius: 12px;
        }

        #pageLoadBar {
            position: fixed;
            top: 0;
            left: 0;
            height: 3px;
            width: 0;
            background: linear-gradient(90deg, var(--teal), var(--teal-mid));
            z-index: 99999;
            transition: width 0.3s ease;
            pointer-events: none;
        }

        #backToTop {
            position: fixed;
            bottom: 28px;
            right: 28px;
            width: 44px;
            height: 44px;
            background: var(--teal);
            color: #fff;
            border: none;
            border-radius: 50%;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 16px rgba(18,168,122,0.4);
            opacity: 0;
            transform: translateY(12px);
            transition: opacity 0.25s ease, transform 0.25s ease;
            z-index: 9000;
        }

            #backToTop.visible {
                opacity: 1;
                transform: translateY(0);
            }

            #backToTop:hover {
                background: var(--teal-dark);
                transform: translateY(-2px);
            }

        @@media (max-width: 768px) {
            #backToTop {
                bottom: 16px;
                right: 16px;
            }
        }
    </style>

    <script>
        // Apply the saved theme before the page paints (see wwwroot/js/darkmode.js).
        (function() {
            if (localStorage.getItem('cedardelivery-dark') === '1') {
                document.documentElement.classList.add('dark-mode');
            }
        })();
    </script>
</head>
<body class="@(User.IsInRole(Roles.Admin) ? "admin-theme" : User.IsInRole(Roles.Merchant) || User.IsInRole(Roles.Driver) ? "agent-theme" : "") @(ViewBag.PageClass ?? "page-dashboard")">

    @{
        var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        bool isAuth = User.Identity?.IsAuthenticated == true;
        bool isAdmin = User.IsInRole(Roles.Admin);
        bool isMerchant = User.IsInRole(Roles.Merchant);
        bool isDriver = User.IsInRole(Roles.Driver);
        var userIdHash = isAuth ? User.Identity!.Name?.GetHashCode() ?? 0 : 0;
        var avatarColorNumber = (Math.Abs(userIdHash) % 8) + 1;
    }

    @if (!isAuth)
    {
        <nav class="public-nav">
            <div class="sidebar-brand public-nav-brand">
                <div class="brand-icon">
                    <img src="/images/cedardelivery-icon.png" alt="CedarDelivery" style="width:28px;height:28px;object-fit:contain" />
                </div>
                <span class="brand-name">
                    Cedar<span class="brand-accent">Delivery</span>
                </span>
            </div>
            <div class="public-nav-links">
                <button id="darkModeBtn" type="button" class="topbar-btn" onclick="toggleDarkMode()" title="Toggle dark mode">
                    <i class="bi bi-moon"></i>
                </button>
                <a asp-area="Identity" asp-page="/Account/Login" class="btn-login">Login</a>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn-register">Register</a>
            </div>
        </nav>
        <div class="public-content">
            @if (TempData["Error"] != null)
            {
                <div class="alert-tp error" style="max-width:960px;margin:16px auto 0">
                    <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
                </div>
            }
            @RenderBody()
        </div>
    }
    else
    {
        <div class="app-wrapper">
            <aside class="sidebar" id="sidebar">
                <div class="sidebar-brand">
                    <button onclick="toggleSidebar()" class="sidebar-brand-btn">
                        <div class="brand-icon">
                            <img src="/images/cedardelivery-icon.png" alt="CedarDelivery" style="width:28px;height:28px;object-fit:contain" />
                        </div>
                        <span class="brand-name brand-text">
                            Cedar<span class="brand-accent">Delivery</span>
                        </span>
                    </button>
                </div>

                <div class="sidebar-section-label">ORDER</div>
                <nav class="sidebar-nav">
                    <a asp-controller="Stores" asp-action="Index" class="nav-item @(ctrl == "Stores" ? "active" : "")">
                        <i class="bi bi-shop"></i>
                        <span class="brand-text">Browse Stores</span>
                    </a>
                    <a asp-controller="Cart" asp-action="Index" class="nav-item @(ctrl == "Cart" ? "active" : "")">
                        <i class="bi bi-cart3"></i>
                        <span class="brand-text">My Cart</span>
                        <span class="nav-badge" id="cartSidebarBadge" style="display:none"></span>
                    </a>
                    <a asp-controller="Orders" asp-action="Index" class="nav-item @(ctrl == "Orders" ? "active" : "")">
                        <i class="bi bi-receipt"></i>
                        <span class="brand-text">My Orders</span>
                    </a>
                    <a asp-controller="Addresses" asp-action="Index" class="nav-item @(ctrl == "Addresses" ? "active" : "")">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span class="brand-text">Addresses</span>
                    </a>
                </nav>

                @if (isMerchant || isAdmin)
                {
                    <div class="sidebar-section-label">MERCHANT</div>
                    <nav class="sidebar-nav">
                        <a asp-controller="Merchant" asp-action="Index" class="nav-item @(ctrl == "Merchant" ? "active" : "")">
                            <i class="bi bi-shop-window"></i>
                            <span class="brand-text">My Stores</span>
                        </a>
                    </nav>
                }

                @if (isDriver)
                {
                    <div class="sidebar-section-label">DRIVER</div>
                    <nav class="sidebar-nav">
                        <a asp-controller="Deliveries" asp-action="Index" class="nav-item @(ctrl == "Deliveries" && action == "Index" ? "active" : "")">
                            <i class="bi bi-scooter"></i>
                            <span class="brand-text">Deliveries</span>
                        </a>
                        <a asp-controller="Deliveries" asp-action="History" class="nav-item @(ctrl == "Deliveries" && action == "History" ? "active" : "")">
                            <i class="bi bi-clock-history"></i>
                            <span class="brand-text">Delivery History</span>
                        </a>
                    </nav>
                }

                @if (isAdmin)
                {
                    <div class="sidebar-section-label">ADMIN</div>
                    <nav class="sidebar-nav">
                        <a asp-controller="Admin" asp-action="Index" class="nav-item @(ctrl == "Admin" && action == "Index" ? "active" : "")">
                            <i class="bi bi-speedometer2"></i>
                            <span class="brand-text">Dashboard</span>
                        </a>
                        <a asp-controller="Admin" asp-action="Stores" class="nav-item @(ctrl == "Admin" && action == "Stores" ? "active" : "")">
                            <i class="bi bi-patch-check-fill"></i>
                            <span class="brand-text">Store Approvals</span>
                        </a>
                        <a asp-controller="Admin" asp-action="Applications" class="nav-item @(ctrl == "Admin" && action == "Applications" ? "active" : "")">
                            <i class="bi bi-person-check-fill"></i>
                            <span class="brand-text">Applications</span>
                        </a>
                        <a asp-controller="Admin" asp-action="Users" class="nav-item @(ctrl == "Admin" && action == "Users" ? "active" : "")">
                            <i class="bi bi-people-fill"></i>
                            <span class="brand-text">Users</span>
                        </a>
                        <a asp-controller="Admin" asp-action="Orders" class="nav-item @(ctrl == "Admin" && action == "Orders" ? "active" : "")">
                            <i class="bi bi-list-check"></i>
                            <span class="brand-text">All Orders</span>
                        </a>
                        <a asp-controller="Admin" asp-action="Activity" class="nav-item @(ctrl == "Admin" && action == "Activity" ? "active" : "")">
                            <i class="bi bi-shield-check"></i>
                            <span class="brand-text">Activity Log</span>
                        </a>
                    </nav>
                }

                <div class="sidebar-section-label">PERSONAL</div>
                <nav class="sidebar-nav">
                    <a asp-controller="Notifications" asp-action="Index" class="nav-item @(ctrl == "Notifications" ? "active" : "")">
                        <i class="bi bi-bell-fill"></i>
                        <span class="brand-text">Notifications</span>
                    </a>
                    <a asp-controller="Account" asp-action="Profile" class="nav-item @(ctrl == "Account" && action == "Profile" ? "active" : "")">
                        <i class="bi bi-person-fill"></i>
                        <span class="brand-text">My Profile</span>
                    </a>
                    @if (!isAdmin && !(isMerchant && isDriver))
                    {
                        <a asp-controller="Account" asp-action="Apply" class="nav-item @(ctrl == "Account" && action == "Apply" ? "active" : "")">
                            <i class="bi bi-briefcase-fill"></i>
                            <span class="brand-text">Sell or Deliver</span>
                        </a>
                    }
                    <a asp-controller="Account" asp-action="Activity" class="nav-item @(ctrl == "Account" && action == "Activity" ? "active" : "")">
                        <i class="bi bi-shield-check"></i>
                        <span class="brand-text">My Activity</span>
                    </a>
                </nav>

                <div class="sidebar-bottom">
                    <div class="sidebar-user">
                        @if (!string.IsNullOrEmpty(ViewBag.ProfilePictureUrl as string))
                        {
                            <img src="@ViewBag.ProfilePictureUrl" class="sidebar-avatar-img" />
                        }
                        else
                        {
                            <div class="sidebar-avatar-initials avatar-color-@avatarColorNumber">
                                @(ViewBag.UserInitials ?? "?")
                            </div>
                        }
                        <div class="sidebar-user-info brand-text">
                            <div class="sidebar-user-name">
                                @(ViewBag.FullName ?? "User")
                            </div>
                            <div class="sidebar-user-role">
                                @if (isAdmin)
                                {
                                    <span>Administrator</span>
                                }
                                else if (isMerchant)
                                {
                                    <span>Merchant</span>
                                }
                                else if (isDriver)
                                {
                                    <span>Driver</span>
                                }
                                else
                                {
                                    <span>Customer</span>
                                }
                            </div>
                        </div>
                    </div>

                    <nav class="sidebar-nav">
                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                            <button type="submit" class="nav-item logout-btn logout-btn-full">
                                <i class="bi bi-box-arrow-left"></i>
                                <span class="brand-text">Sign Out</span>
                            </button>
                        </form>
                    </nav>
                </div>
            </aside>

            <div class="main-content" id="mainContent">
                <header class="topbar">
                    <div class="topbar-left">
                        <div class="page-title">
                            <h1>@(ViewData["Title"] ?? "CedarDelivery")</h1>
                            <div class="page-date">
                                @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                            </div>
                        </div>
                    </div>

                    <div class="topbar-right">
                        <button id="darkModeBtn" type="button" class="topbar-btn" onclick="toggleDarkMode()" title="Toggle dark mode">
                            <i class="bi bi-moon"></i>
                        </button>

                        <a asp-controller="Cart" asp-action="Index" class="topbar-btn" title="Cart">
                            <i class="bi bi-cart3"></i>
                            <span class="notification-dot" id="cartBadge" style="display:none">0</span>
                        </a>

                        <a asp-controller="Notifications" asp-action="Index" class="topbar-btn" title="Notifications">
                            <i class="bi bi-bell-fill"></i>
                            <span class="notification-dot" id="notifBadge" style="display:none">0</span>
                        </a>

                        <a asp-controller="Account" asp-action="Profile" class="user-avatar" title="@(ViewBag.FullName ?? "Profile")">
                            @if (!string.IsNullOrEmpty(ViewBag.ProfilePictureUrl as string))
                            {
                                <img src="@ViewBag.ProfilePictureUrl" class="user-avatar-img" />
                            }
                            else
                            {
                                <div class="avatar-initials avatar-color-@avatarColorNumber">
                                    @(ViewBag.UserInitials ?? "?")
                                </div>
                            }
                        </a>
                    </div>
                </header>

                <div class="alerts-container">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert-tp success">
                            <i class="bi bi-check-circle-fill"></i>
                            @TempData["Success"]
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert-tp error">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            @TempData["Error"]
                        </div>
                    }
                </div>

                <main class="page-content">
                    @RenderBody()
                </main>
            </div>
        </div>
    }

    @* Faint cedar-tree background, same as CedarPay. *@
    <svg style="position: fixed; bottom: 0; left: 0; width: 100%; height: 260px; z-index: 0; pointer-events: none; opacity: 0.04;">
        <defs>
            <g id="cedar-tree-simple">
                <polygon points="20,50 35,15 50,50" />
                <polygon points="22,40 35,10 48,40" />
                <polygon points="24,30 35,5 46,30" />
                <rect x="33" y="50" width="4" height="25" />
            </g>
        </defs>
        <use href="#cedar-tree-simple" x="30" y="180" transform="scale(0.8)" />
        <use href="#cedar-tree-simple" x="180" y="160" transform="scale(1)" />
        <use href="#cedar-tree-simple" x="350" y="190" transform="scale(0.9)" />
        <use href="#cedar-tree-simple" x="520" y="150" transform="scale(1.1)" />
        <use href="#cedar-tree-simple" x="700" y="185" transform="scale(0.85)" />
        <use href="#cedar-tree-simple" x="880" y="165" transform="scale(1)" />
        <use href="#cedar-tree-simple" x="1050" y="195" transform="scale(0.75)" />
        <use href="#cedar-tree-simple" x="1220" y="170" transform="scale(1.05)" />
    </svg>

    <div id="pageLoadBar"></div>
    <button id="backToTop" onclick="window.scrollTo({top:0,behavior:'smooth'})" title="Back to top">
        <i class="bi bi-chevron-up"></i>
    </button>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/darkmode.js" asp-append-version="true"></script>

    <script>
        // Collapse/expand the sidebar and remember the choice.
        function toggleSidebar() {
            var sidebar = document.getElementById('sidebar');
            var main = document.getElementById('mainContent');
            var isMini = sidebar.classList.toggle('mini');
            main.classList.toggle('sidebar-mini', isMini);
            localStorage.setItem('sidebarMini', isMini ? '1' : '0');
            updateSidebarText(isMini);
        }

        function updateSidebarText(isMini) {
            document.querySelectorAll('.brand-text').forEach(function(el) {
                el.style.display = isMini ? 'none' : '';
            });
            document.querySelectorAll('.sidebar-section-label').forEach(function(el) {
                el.style.display = isMini ? 'none' : '';
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            var sidebar = document.getElementById('sidebar');
            if (sidebar && localStorage.getItem('sidebarMini') === '1') {
                sidebar.classList.add('mini');
                document.getElementById('mainContent').classList.add('sidebar-mini');
                updateSidebarText(true);
            }

            // Thin progress bar at the top on page load.
            setTimeout(function() {
                document.getElementById('pageLoadBar').style.width = '100%';
                setTimeout(function() {
                    document.getElementById('pageLoadBar').style.width = '0%';
                }, 300);
            }, 100);
        });

        // Show the back-to-top button after scrolling down.
        window.addEventListener('scroll', function() {
            var btn = document.getElementById('backToTop');
            btn.classList.toggle('visible', window.scrollY > 300);
        });
    </script>

    @if (isAuth)
    {
        <script>
            // Top-bar badges: unread notifications and items in the cart.
            // Refreshed every 30 seconds (Phase 5 pushes updates live with SignalR).
            function setBadge(id, count) {
                var badge = document.getElementById(id);
                if (!badge) return;
                badge.textContent = count > 9 ? '9+' : count;
                badge.style.display = count > 0 ? '' : 'none';
            }

            function refreshBadges() {
                fetch('/api/notifications/unread-count')
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (data) { if (data) setBadge('notifBadge', data.unreadCount); })
                    .catch(function () { });

                fetch('/api/cart')
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (cart) {
                        if (!cart) return;
                        var count = cart.items.reduce(function (sum, item) { return sum + item.quantity; }, 0);
                        setBadge('cartBadge', count);
                        setBadge('cartSidebarBadge', count);
                    })
                    .catch(function () { });
            }

            refreshBadges();
            setInterval(refreshBadges, 30000);
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
