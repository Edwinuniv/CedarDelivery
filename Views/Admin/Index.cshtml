@model AnalyticsDto
@{
    ViewData["Title"] = "Admin Dashboard";
    ViewBag.PageClass = "page-admin";
}

<div class="page-header">
    <div>
        <h2>Dashboard</h2>
        <p>Last @Model.Days days</p>
    </div>
    <div class="d-flex gap-2">
        @foreach (var days in new[] { 7, 30, 90 })
        {
            <a asp-action="Index" asp-route-days="@days" class="@(Model.Days == days ? "btn-tp-primary" : "btn-tp-secondary")">@days days</a>
        }
    </div>
</div>

@if (Model.PendingStores > 0 || Model.PendingApplications > 0)
{
    <div class="alert-tp error mb-3">
        <i class="bi bi-bell-fill"></i>
        Waiting for you:
        @if (Model.PendingStores > 0)
        {
            <a asp-action="Stores">@Model.PendingStores store(s)</a>
        }
        @if (Model.PendingApplications > 0)
        {
            <a asp-action="Applications">@Model.PendingApplications application(s)</a>
        }
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="stat-card"><div class="stat-icon received"><i class="bi bi-cash-stack"></i></div>
            <div class="stat-value">@Ui.Money(Model.Revenue)</div><div class="stat-label">Revenue (delivered)</div>
            <div class="stat-sub">Avg order @Ui.Money(Model.AverageOrderValue)</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card"><div class="stat-icon sent"><i class="bi bi-receipt"></i></div>
            <div class="stat-value">@Model.TotalOrders</div><div class="stat-label">Orders</div>
            <div class="stat-sub">@Model.DeliveredOrders delivered · @Model.CancelledOrRejectedOrders cancelled</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card"><div class="stat-icon gold"><i class="bi bi-scooter"></i></div>
            <div class="stat-value">@Model.OnlineDrivers</div><div class="stat-label">Drivers online</div>
            <div class="stat-sub">@Model.ActiveOrders active order(s)</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card"><div class="stat-icon beneficiaries"><i class="bi bi-people-fill"></i></div>
            <div class="stat-value">@Model.TotalUsers</div><div class="stat-label">Users</div>
            <div class="stat-sub">@Model.ApprovedStores store(s) live</div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="tp-card">
            <div class="tp-card-header"><div class="tp-card-title">Orders per day</div></div>
            <canvas id="ordersChart" height="120"></canvas>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="tp-card">
            <div class="tp-card-header"><div class="tp-card-title">Top stores</div></div>
            @if (!Model.TopStores.Any())
            {
                <p class="text-muted mb-0">No delivered orders in this period.</p>
            }
            @foreach (var store in Model.TopStores)
            {
                <div class="d-flex justify-content-between py-2" style="border-top:1px solid var(--border)">
                    <a asp-controller="Stores" asp-action="Details" asp-route-id="@store.StoreId">@store.StoreName</a>
                    <span><strong>@Ui.Money(store.Revenue)</strong> <span class="text-muted">(@store.DeliveredOrders)</span></span>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js"></script>
    <script>
        // Data comes from AnalyticsDto.OrdersPerDay (one entry per day, zeros included).
        var days = @Json.Serialize(Model.OrdersPerDay.Select(d => d.Date.ToString("dd MMM")));
        var orders = @Json.Serialize(Model.OrdersPerDay.Select(d => d.Orders));
        var revenue = @Json.Serialize(Model.OrdersPerDay.Select(d => d.Revenue));
        var teal = getComputedStyle(document.documentElement).getPropertyValue('--teal').trim() || '#12a87a';

        new Chart(document.getElementById('ordersChart'), {
            data: {
                labels: days,
                datasets: [
                    { type: 'bar', label: 'Orders', data: orders, backgroundColor: teal, yAxisID: 'y' },
                    { type: 'line', label: 'Revenue ($)', data: revenue, borderColor: '#D4AF37', tension: 0.3, yAxisID: 'y1' }
                ]
            },
            options: {
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 }, title: { display: true, text: 'Orders' } },
                    y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false }, title: { display: true, text: '$' } }
                }
            }
        });
    </script>
}
