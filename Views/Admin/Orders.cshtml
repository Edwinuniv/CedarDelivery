@model PagedResult<OrderSummaryDto>
@{
    ViewData["Title"] = "All Orders";
    ViewBag.PageClass = "page-admin";
    var query = (OrderQuery)ViewBag.Query;
}

<div class="page-header">
    <div>
        <h2>All orders</h2>
        <p>@Model.TotalCount order(s)</p>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Orders" class="@(query.Status == null ? "btn-tp-primary" : "btn-tp-secondary")">All</a>
    @foreach (var status in Enum.GetValues<OrderStatus>())
    {
        <a asp-action="Orders" asp-route-status="@status" class="@(query.Status == status ? "btn-tp-primary" : "btn-tp-secondary")">@Ui.Words(status)</a>
    }
</div>

@if (!Model.Items.Any())
{
    <div class="tp-card"><div class="empty-state"><i class="bi bi-inbox" style="font-size:40px;display:block;margin-bottom:12px"></i><p>No orders.</p></div></div>
}
else
{
    <partial name="_OrderTable" model="Model.Items" />
    <partial name="_Pager" model="(Model.Page, Model.TotalPages)" />
}
