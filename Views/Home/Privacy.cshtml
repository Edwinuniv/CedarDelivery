@{
    ViewData["Title"] = "Privacy";
}

<div class="tp-card" style="max-width:820px;margin:24px auto">
    <h2>Privacy</h2>
    <p class="text-muted">CedarDelivery is a student portfolio project. This page explains what the app stores and why.</p>

    <h5 class="mt-3">What we store</h5>
    <ul>
        <li><strong>Account:</strong> name, email, phone number (optional) and a hashed password, or your Google sign-in.</li>
        <li><strong>Addresses:</strong> the delivery addresses you save, and a map pin if you add one.</li>
        <li><strong>Orders:</strong> what you ordered, from which store, the delivery address and the order timeline.</li>
        <li><strong>Drivers:</strong> vehicle details and, only while online, the last known location.</li>
        <li><strong>Activity log:</strong> sign-ins and important actions with the IP address, so you can spot unusual activity.</li>
    </ul>

    <h5 class="mt-3">Who sees it</h5>
    <ul>
        <li>The store sees your name, phone and address for the orders you place there.</li>
        <li>The driver sees the same for the order they deliver.</li>
        <li>Public reviews show only your first name and last initial.</li>
        <li>Admins can see accounts and orders to run the platform.</li>
    </ul>

    <p class="text-muted mb-0">Payments are cash on delivery; no card details are stored.</p>
</div>
