@model List<StoreDto>
@{
    ViewData["Title"] = "My Stores";
}

<div class="page-header">
    <div>
        <h2>My stores</h2>
        <p>Manage your menus, opening status and orders</p>
    </div>
    <a asp-action="Create" class="btn-tp-primary"><i class="bi bi-plus-lg"></i> New store</a>
</div>

@if (!Model.Any())
{
    <div class="tp-card">
        <div class="empty-state">
            <i class="bi bi-shop-window" style="font-size:40px;display:block;margin-bottom:12px"></i>
            <p>You don't have a store yet.</p>
            <a asp-action="Create" class="btn-tp-primary mt-2"><i class="bi bi-plus-lg"></i> Create your first store</a>
        </div>
    </div>
}

<div class="row g-3">
    @foreach (var store in Model)
    {
        <div class="col-md-6">
            <div class="tp-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <div class="tp-card-title" style="margin:0">@store.Name</div>
                        <div class="text-muted" style="font-size:13px">@store.Category · @Ui.Rating(store.AverageRating, store.ReviewCount)</div>
                    </div>
                    @if (!store.IsApproved)
                    {
                        <span class="badge-tp warning">Waiting for approval</span>
                    }
                    else if (store.IsAcceptingOrders)
                    {
                        <span class="badge-tp success">Taking orders</span>
                    }
                    else
                    {
                        <span class="badge-tp default">@(store.IsOpen ? "Outside opening hours" : "Closed")</span>
                    }
                </div>
                <div class="text-muted mb-3" style="font-size:13px">
                    <i class="bi bi-clock"></i> @Ui.Hours(store.OpensAt, store.ClosesAt) ·
                    <i class="bi bi-scooter"></i> @Ui.Money(store.DeliveryFee)
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Orders" asp-route-id="@store.Id" class="btn-tp-primary"><i class="bi bi-receipt"></i> Orders</a>
                    <a asp-action="Menu" asp-route-id="@store.Id" class="btn-tp-secondary"><i class="bi bi-journal-text"></i> Menu</a>
                    <a asp-action="Edit" asp-route-id="@store.Id" class="btn-tp-secondary"><i class="bi bi-pencil"></i> Edit</a>
                    <a asp-controller="Stores" asp-action="Details" asp-route-id="@store.Id" class="btn-tp-secondary"><i class="bi bi-eye"></i> View</a>
                    @if (store.IsApproved)
                    {
                        <form asp-action="SetOpen" asp-route-id="@store.Id" method="post">
                            <input type="hidden" name="isOpen" value="@(!store.IsOpen)" />
                            <button type="submit" class="@(store.IsOpen ? "btn-tp-danger" : "btn-tp-primary")">
                                <i class="bi @(store.IsOpen ? "bi-door-closed" : "bi-door-open")"></i> @(store.IsOpen ? "Close" : "Open")
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>
